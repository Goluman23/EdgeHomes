# ---- Edgehomes lead-api · Vercel project "edgehomes-lead-api" (Root Directory: lead-api) ----
# Production variables. The client adds every key here themselves; keys never pass through chat.
# A changed variable needs a fresh deploy from a git push (redeploying an old deployment keeps old values).

# Day 1
CONCIERGE_KEY=            # random secret EasySocial puts in the concierge URL (?key=)
ANTHROPIC_API_KEY=        # Claude Console workspace "Edgehomes", monthly spend cap
SHEET_LOG_URL=            # Apps Script web app URL (…/exec) of the sheet "Edgehomes Leads"
SHEET_LOG_SECRET=         # same value as Script property SHEET_LOG_SECRET
ES_WEBHOOK_VERIFY_TOKEN=  # typed into EasySocial → Settings → Webhooks
LEAD_API_KEY=             # x-api-key for n8n / server-to-server calls to /api/lead

# Brand facts (defaults come from the website: Faridabad, Haryana · Mon–Sat 10 AM – 7 PM)
EH_STUDIO_ADDRESS=        # full street address once confirmed
EH_MAP_LINK=              # exact Google Maps pin (default: Maps search for "Edgehomes Architects Faridabad")
EH_HOURS=                 # override only if the website hours change
EH_EMAIL=
EH_DESIGNER=our design lead
EH_OWN_NUMBERS=           # comma-separated studio/staff numbers never to message in campaigns

# When tags exist in EasySocial
ES_ACCESS_TOKEN=          # EasySocial client API token (tags, lead fields)
ES_API_BASE=              # confirmed in the audit
ES_TAG_PATH=
ES_FIELD_PATH=
ES_TAG_IDS={}             # {"SUPPRESS_OPT_OUT":"<id>","SUPPRESS_MARKETING":"<id>",...}

# Campaigns and follow-ups (EasySocial → Broadcast → Create API campaign → copy its cURL)
ES_CAMPAIGNS={}           # {"referral_dec26":"curl …","fu_eh_fu_d1_guide":"curl …",...}
CAMPAIGN_PUSH_KEY=        # mark Sensitive
ES_AUTH_KEY=              # EasySocial send API key, if the cURL needs it separately

# Meta Conversions API (Events Manager → dataset → Settings → Generate access token)
META_PIXEL_ID=            # dataset / Pixel ID (same as the website)
META_CAPI_TOKEN=          # Sensitive
META_TEST_EVENT_CODE=     # optional, only while testing in Events Manager → Test events

# Optional
CLAUDE_MODEL=claude-haiku-5-5
PROVIDER=easysocial       # or manychat (MC_API_KEY, MC_FLOWS)
ALLOWED_ORIGINS=https://edgehomesarchitects.in,https://www.edgehomesarchitects.in,https://edgehomes.vercel.app

# Go-live switches — only on the client's go
FOLLOWUP_LIVE=
CAMPAIGN_LIVE=
