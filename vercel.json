{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/lead-api/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lead-api",
      "destination": "/",
      "permanent": false
    }
  ]
}